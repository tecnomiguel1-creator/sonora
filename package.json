{
  "name": "sonora",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Sonora: tu música, sin anuncios. Sube canciones desde el celular o la PC y escúchalas en todos tus dispositivos.",
  "author": "Sonora",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "node server.js",
    "app": "electron .",
    "instalador": "electron-builder --win --x64"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "electron-updater": "^6.8.9",
    "express": "^4.22.3",
    "multer": "^2.4.0",
    "music-metadata": "^12.1.1"
  },
  "devDependencies": {
    "electron": "^44.7.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "app.sonora.music.desktop",
    "productName": "Sonora",
    "copyright": "Sonora",
    "asar": false,
    "artifactName": "${productName}-Instalador-${version}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "server.js",
      "public/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Sonora",
      "language": "3082",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false
    }
  }
}
